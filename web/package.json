{
  "name": "pr0former-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:load": "PR0_LOAD=1 playwright test",
